<div class="py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-12">

        <!-- Direct Reach Out Channels -->
        <div class="md:col-span-5 space-y-6">
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Direct Reach Out</span>
                <h1 class="font-heading text-3xl font-extrabold text-slate-900 mt-1">Request Your Quote</h1>
                <p class="text-slate-600 text-sm mt-3">Fill in your project details and I'll get back to you, or reach me directly on WhatsApp or email.</p>
            </div>

            <div class="space-y-4 pt-4 border-t border-slate-200">
                <!-- WhatsApp Card -->
                <a href="<%= site.whatsappLink("Hi Nolundi, I'd like to discuss a new website project.") %>"
                   target="_blank" rel="noopener"
                   class="flex items-center space-x-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl hover:bg-emerald-100 transition">
                    <i class="fa-brands fa-whatsapp text-emerald-600 text-3xl" aria-hidden="true"></i>
                    <div>
                        <p class="text-sm font-bold text-slate-900">Direct WhatsApp</p>
                        <p class="text-xs text-slate-600"><%= site.whatsappDisplay %> — click to start an immediate chat</p>
                    </div>
                </a>

                <!-- Direct Email Card -->
                <a href="<%= site.emailLink %>" class="flex items-center space-x-4 p-4 bg-white border border-slate-200 rounded-xl hover:border-brand-primary transition shadow-sm">
                    <i class="fa-solid fa-envelope text-brand-primary text-2xl" aria-hidden="true"></i>
                    <div>
                        <p class="text-sm font-bold text-slate-900">Direct Email</p>
                        <p class="text-xs text-brand-primary font-medium"><%= site.email %></p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Quote Request Form -->
        <div class="md:col-span-7 bg-white p-8 rounded-2xl shadow-lg border border-slate-200">
            <form id="quoteForm" class="space-y-4" data-whatsapp="<%= site.whatsappNumber %>" novalidate>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="clientName" class="block text-xs font-bold uppercase text-slate-700 mb-1">Your Name</label>
                        <input type="text" id="clientName" name="name" required autocomplete="name"
                               placeholder="e.g. Sipho"
                               class="w-full px-4 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-primary outline-none">
                    </div>
                    <div>
                        <label for="businessName" class="block text-xs font-bold uppercase text-slate-700 mb-1">Business Name</label>
                        <input type="text" id="businessName" name="business" autocomplete="organization"
                               placeholder="e.g. Apex Mechanics"
                               class="w-full px-4 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-primary outline-none">
                    </div>
                </div>

                <div>
                    <label for="packageTier" class="block text-xs font-bold uppercase text-slate-700 mb-1">Package / Service</label>
                    <select id="packageTier" name="tier" required
                            class="w-full px-4 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-brand-primary outline-none">
                        <% tiers.forEach(function (tier) { %>
                            <option value="<%= tier.slug %>" <%= selectedTier === tier.slug ? 'selected' : '' %>><%= tier.optionLabel %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label for="projectNotes" class="block text-xs font-bold uppercase text-slate-700 mb-1">Project Details</label>
                    <textarea id="projectNotes" name="notes" rows="4"
                              placeholder="Briefly describe what your business does and any special requirements..."
                              class="w-full px-4 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-primary outline-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 rounded-lg shadow text-xs tracking-wider uppercase transition flex items-center justify-center gap-2">
                    <i class="fa-brands fa-whatsapp text-lg" aria-hidden="true"></i> Send via WhatsApp
                </button>

                <!-- TODO(checkpoint 3): this form still posts to wa.me via JS.
                     Replaced by a real POST /contact with server-side validation. -->
            </form>
        </div>

    </div>
</div>

<script src="/js/contact.js" defer></script>
