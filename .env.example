# Copy to .env and fill in. Never commit .env.

# Public URL of the deployed site, no trailing slash.
# Drives canonical URLs, sitemap.xml and Open Graph tags.
# Leave unset locally — it falls back to http://localhost:3000.
BASE_URL=

PORT=3000
NODE_ENV=development

# --- Email (checkpoint 3) -------------------------------------------------
# Nolundi's own transactional email endpoint.
EMAIL_API_URL=https://email-api-git-main-giftsibusisos-projects.vercel.app/v1/send-email
EMAIL_API_KEY=
# Where enquiry notifications are delivered.
ENQUIRY_RECIPIENT=nolundimendi4@gmail.com

# --- AI chat assistant (checkpoint 4) -------------------------------------
ANTHROPIC_API_KEY=
